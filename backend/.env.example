# PostgreSQL connection for the transactional application data store.
DATABASE_URL=postgresql+psycopg2://visa_app:visa_app@localhost:5432/visa_application

# Separate connection/schema for the immutable audit/event store (T011).
AUDIT_DATABASE_URL=postgresql+psycopg2://visa_app:visa_app@localhost:5432/visa_application_audit

# Mock/stub integration mode. All external adapters return canned responses
# when true; no outbound network calls are made. Keep true in this scaffold.
INTEGRATIONS_MOCKED=true

# Secrets are never committed. Populate real values only in a protected
# secret manager for non-scaffold environments.
IDENTITY_PROVIDER_JWT_SECRET=change-me-in-real-environment
NOTIFICATION_GATEWAY_API_KEY=change-me-in-real-environment
